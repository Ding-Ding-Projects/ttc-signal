      }
    ]
  },
  {
    "name": "Ionview",
    "lines": [
      5
    ],
    "source": "https://www.ttc.ca/subway-stations/ionview-station",
    "events": [
      {
        "date": "2019",
        "text": "Metrolinx published the proposed layout west of Ionview Road, with covered waiting areas and fare machines on the parallel platforms.",
        "source": "https://www.metrolinx.com/en/discover/birchmount-and-ionview-crosstown-stops-pave-the-way"
      },
      {
        "date": "2026-02-08",
        "text": "The surface stop opened at Ionview Road, the final eastbound stop before Kennedy.",
        "source": "https://www.metrolinx.com/en/projects-and-programs/eglinton-crosstown-lrt/what-were-building",
        "dateSource": "https://www.toronto.ca/services-payments/streets-parking-transportation/transit-in-toronto/transit-expansion/eglinton-crosstown-and-proposed-extensions/"
      }
    ]
  },
  {
    "name": "Kennedy",
    "lines": [
      2,
      5
    ],
    "source": "https://www.ttc.ca/subway-stations/kennedy-station",
    "events": [
      {
        "date": "2018",
        "text": "In March, crews built the underpass between the GO platforms during a 75-hour work window as part of the interchange project.",
        "source": "https://www.metrolinx.com/en/discover/take-a-walk-through-tour-of-kennedy-station"
      },
      {
        "date": "2026-02-08",

      },
      {
        "date": "2026-02-08",
        "text": "Light rail began serving the intersection of Birchmount Road and Eglinton Avenue East, between Golden Mile and Ionview.",
        "source": "https://www.metrolinx.com/en/projects-and-programs/eglinton-crosstown-lrt/what-were-building",

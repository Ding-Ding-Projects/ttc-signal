[
  {
    "name": "Mount Dennis",
    "lines": [
      5
    ],
    "source": "https://www.ttc.ca/subway-stations/mount-dennis-station",
    "events": [
      {
        "date": "2016",
        "text": "Workers lifted the former Kodak building and moved it roughly 60 metres so they could excavate beneath its original site.",
        "source": "https://www.metrolinx.com/en/discover/former-kodak-building-used-for-crosstown-mount-dennis-station"
      },
      {
        "date": "2025-11-16",
        "text": "Kitchener GO trains and UP Express began serving Mount Dennis. TTC buses also started using the station before the LRT opened.",
        "source": "https://www.metrolinx.com/en/news/mount-dennis-station-opens-to-go-up-and-ttc-customers"
      },
      {
        "date": "2026-02-08",
        "text": "Line 5 began at the western terminal, where the former Kodak building connects the LRT with Kitchener GO trains and UP Express.",
        "source": "https://www.metrolinx.com/en/projects-and-programs/eglinton-crosstown-lrt/what-were-building",
        "dateSource": "https://www.toronto.ca/services-payments/streets-parking-transportation/transit-in-toronto/transit-expansion/eglinton-crosstown-and-proposed-extensions/"
      }
    ]
  },
  {
    "name": "Keelesdale",
    "lines": [
      5
    ],
    "source": "https://www.ttc.ca/subway-stations/keelesdale-station",
    "events": [
      {
        "date": "2016-03-10",
        "text": "Construction of Keelesdale Station began with a groundbreaking ceremony.",
